# Copia este archivo a .env (no se sube al repo) y completa los valores.

NODE_ENV=development
PORT=3000

# Nivel de logs: debug (por defecto en desarrollo) | info (producción) | warn | error
LOG_LEVEL=debug

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=unitrack
DB_PASSWORD=
DB_NAME=unitrack

# Secreto para firmar los JWT. Genera uno largo y aleatorio:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Proxies delante de la app (0 en local; 1 detrás de Caddy/Nginx)
TRUST_PROXY=0

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGIN=http://localhost:5173
